table ml_feature_importance

	column feature
		dataType: string
		summarizeBy: none
		sourceColumn: feature

	column auc_drop_when_shuffled
		dataType: double
		summarizeBy: none
		sourceColumn: auc_drop_when_shuffled

	column abs_coef_standardised
		dataType: double
		summarizeBy: none
		sourceColumn: abs_coef_standardised

	measure 'Driver Importance' = SUM ( ml_feature_importance[auc_drop_when_shuffled] )
		formatString: 0.000
		displayFolder: Model

	partition ml_feature_importance = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataPath & "\ml_feature_importance.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"feature", type text}, {"auc_drop_when_shuffled", type number}, {"abs_coef_standardised", type number}}, "en-US")
				in
					Typed
